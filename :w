inline float PM_Enabled() {
    return pstate_server.predict_flags & PF_CSQC_PMOVE;
}

vector render_origin;
vector render_angles;

void PM_SetupRender() {
    if (!PM_Enabled())
        return;
    printf("SR\n");

    setproperty(VF_ORIGIN, '0 0 0' + [ 0, 0, getstatf( STAT_VIEWHEIGHT ) ]);
    setproperty(VF_ANGLES, view_angles);
}

float held_pm_flags;
vector held_origin, held_velocity;

void PM_StartUpdate() {
    if (!PM_Enabled()) return;

    self.movetype = MOVETYPE_WALK;
    held_origin = self.origin;
    held_velocity = self.velocity;
    held_pm_flags = self.pmove_flags;

    Phys_Expire(time - SERVER_FRAME_MS);
}

void PM_EndUpdate() {
    if (!PM_Enabled()) return;

#if 0
