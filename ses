[32m+[m
[32m+[m[32m    shells = Dispenser_GiveShells(disp, pl);[m
[32m+[m[32m    nails = Dispenser_GiveNails(disp, pl);[m
[32m+[m[32m    rockets = Dispenser_GiveRockets(disp, pl);[m
